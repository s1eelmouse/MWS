# Training/benchmark image. Choose a CUDA wheel index supported by the server driver.
FROM python:3.12-slim
ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cu126
ARG CODE_REVISION=unknown
ENV PYTHONUNBUFFERED=1 PYTHONIOENCODING=utf-8 PYTHONPYCACHEPREFIX=/tmp/pycache HF_HOME=/cache/huggingface \
    MWS_CODE_REVISION=${CODE_REVISION}
WORKDIR /app
COPY requirements.txt requirements-cpu.txt ./
COPY docs/migrations/4090-to-v100/constraints-v100.txt ./constraints-v100.txt
RUN python -m pip install --no-cache-dir 'torch==2.14.1' --index-url "${TORCH_INDEX_URL}" \
    && python -m pip install --no-cache-dir -r requirements.txt -r requirements-cpu.txt -c constraints-v100.txt \
    && python -m pip check \
    && python -m pip freeze > /image-packages.txt \
    && groupadd --gid 10001 app \
    && useradd --uid 10001 --gid app --create-home app \
    && mkdir -p /app/out /cache/huggingface \
    && chown -R app:app /app/out /cache
COPY src ./src
COPY tests ./tests
COPY docs/migrations/4090-to-v100 ./docs/migrations/4090-to-v100
COPY docs/evaluations ./docs/evaluations
COPY Dockerfile docker-compose.yml docker-compose.vllm.yml requirements-serve.txt .dockerignore ./
USER 10001:10001
ENTRYPOINT ["python", "-u", "src/run_experiment.py"]
